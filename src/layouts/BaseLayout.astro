---
import Footer from '@/components/Footer.astro';
import Navigation from '@/components/Navigation.astro';
import { resolveAssetPath } from '@/utils/asset';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  socialImage?: string | false;
}

const { title, description, socialImage = 'og.png' } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = socialImage
  ? new URL(resolveAssetPath(socialImage, base), Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yin Yuan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
