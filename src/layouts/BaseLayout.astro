---
import Footer from '@/components/Footer.astro';
import Navigation from '@/components/Navigation.astro';
import { siteConfig } from '@/config/site';
import { getLocaleFromPath, localeMeta, locales, switchLocalePath, useTranslations } from '@/i18n';
import { resolveAssetPath } from '@/utils/asset';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  socialImage?: string | false;
  /** False for pages that exist in only one language, such as the 404 page. */
  translated?: boolean;
}

const { title, description, socialImage = 'og.png', translated = true } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const alternates = translated
  ? locales.map((item) => ({
      hreflang: localeMeta[item].htmlLang,
      href: new URL(switchLocalePath(Astro.url.pathname, item), Astro.site),
    }))
  : [];
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = socialImage
  ? new URL(resolveAssetPath(socialImage, base), Astro.site)
  : undefined;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e6" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'en'), Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    {locale === 'zh' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap"
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skipLink}</a>
    <Navigation locale={locale} translated={translated} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
