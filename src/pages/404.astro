---
import BaseLayout from '@/layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found — Yin Yuan" description="The requested page could not be found." socialImage={false}>
  <section class="not-found shell">
    <p class="eyebrow">Error / 404</p>
    <h1>Off the grid.</h1>
    <p>The page you were looking for does not exist or has moved.</p>
    <a class="button button-primary" href={base}>Return home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
