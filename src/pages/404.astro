---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath } from '@/i18n';
---

<BaseLayout title="Page not found — Yin Yuan" description="The requested page could not be found." socialImage={false} translated={false}>
  <section class="not-found shell">
    <p class="eyebrow">Error / 404</p>
    <h1>Off the grid.</h1>
    <p>The page you were looking for does not exist or has moved.</p>
    <p lang="zh-CN">你要找的页面不存在，或者已经移动到别处。</p>
    <div class="not-found-actions">
      <a class="button button-primary" href={localePath('', 'en')}>Return home <span aria-hidden="true">→</span></a>
      <a class="text-link" href={localePath('', 'zh')} lang="zh-CN">返回中文首页 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
