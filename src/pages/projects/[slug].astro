---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tags from '@/components/Tags.astro';
import CallToAction from '@/components/CallToAction.astro';
import { resolveAssetPath } from '@/utils/asset';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
const base = import.meta.env.BASE_URL;

// Notes still marked TODO in the content file stay out of the public page.
const isPublishable = (value?: string): value is string =>
  Boolean(value && !/^TODO\b/i.test(value.trim()));
const development = isPublishable(data.development) ? data.development : undefined;
const currentProgress = isPublishable(data.currentProgress) ? data.currentProgress : undefined;
const hasGallery = data.gallery.length > 0;

let sectionCount = 0;
const nextSectionNumber = () => String(++sectionCount).padStart(2, '0');
const sectionNumbers = {
  overview: nextSectionNumber(),
  experience: nextSectionNumber(),
  systems: nextSectionNumber(),
  development: development ? nextSectionNumber() : '',
  progress: currentProgress ? nextSectionNumber() : '',
  gallery: hasGallery ? nextSectionNumber() : '',
};
---

<BaseLayout
  title={`${data.title}${data.subtitle ? ` — ${data.subtitle}` : ''} | Yin Yuan`}
  description={data.description}
  socialImage={data.cover?.src ?? false}
>
  <article class="project-detail">
    <header class:list={['project-detail-hero', `detail-${data.visualVariant}`]}>
      <div class="shell">
        <a class="back-link" href={`${base}projects/`}><span aria-hidden="true">←</span> All projects</a>
        <div class="detail-title-grid">
          <div>
            <p class="eyebrow">Project / {String(data.order).padStart(2, '0')}</p>
            <h1>{data.title}</h1>
            {data.subtitle && <p class="detail-subtitle">{data.subtitle}</p>}
          </div>
          <p class="detail-description">{data.description}</p>
        </div>
        <Tags tags={data.tags} dark />
        {data.cover ? (
          <figure class="detail-visual detail-visual-image">
            <img
              src={resolveAssetPath(data.cover.src, base)}
              alt={data.cover.alt}
              width={data.cover.width}
              height={data.cover.height}
              fetchpriority="high"
            />
            {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
          </figure>
        ) : (
          <div class="detail-visual" aria-label="Visual placeholder; project imagery to be added">
            <span>{data.visualLabel}</span>
            <span class="detail-visual-center" aria-hidden="true">+</span>
            <span>IMAGE ARCHIVE / TODO</span>
          </div>
        )}
      </div>
    </header>

    <div class="shell detail-content">
      <section class="detail-section overview-section">
        <div class="detail-section-label"><span>{sectionNumbers.overview}</span><h2>Overview</h2></div>
        <div class="prose"><Content /></div>
      </section>

      <section class="detail-section">
        <div class="detail-section-label"><span>{sectionNumbers.experience}</span><h2>Core Experience</h2></div>
        <ol class="experience-list">
          {data.coreExperience.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
          ))}
        </ol>
      </section>

      <section class="detail-section">
        <div class="detail-section-label"><span>{sectionNumbers.systems}</span><h2>Key Systems</h2></div>
        <div class="systems-grid">
          {data.keySystems.map((system, index) => (
            <article>
              <span>{String.fromCharCode(65 + index)}</span>
              <h3>{system.title}</h3>
              <p>{system.description}</p>
            </article>
          ))}
        </div>
      </section>

      {(development || currentProgress) && (
        <section class:list={['detail-section', 'detail-notes-grid', { 'detail-notes-single': !(development && currentProgress) }]}>
          {development && (
            <div>
              <div class="detail-section-label compact"><span>{sectionNumbers.development}</span><h2>Development</h2></div>
              <p class="neutral-placeholder">{development}</p>
            </div>
          )}
          {currentProgress && (
            <div>
              <div class="detail-section-label compact"><span>{sectionNumbers.progress}</span><h2>Current Progress</h2></div>
              <p class="neutral-placeholder">{currentProgress}</p>
            </div>
          )}
        </section>
      )}

      {hasGallery && (
        <section class="detail-section gallery-section">
          <div class="detail-section-label"><span>{sectionNumbers.gallery}</span><h2>Gallery</h2></div>
          <div class="gallery-grid">
            {data.gallery.map((image) => (
              <figure>
                <img
                  src={resolveAssetPath(image.src, base)}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
  <CallToAction eyebrow="Continue the conversation" />
</BaseLayout>
