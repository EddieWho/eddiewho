---
import ProjectDetailView from '@/views/ProjectDetailView.astro';
import { getProjects, type LocalizedProject } from '@/i18n/content';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: LocalizedProject;
}

const { project } = Astro.props;
---

<ProjectDetailView locale="en" project={project} />
