---
import { getCollection, getEntry } from 'astro:content';
import CallToAction from '@/components/CallToAction.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isTodoValue, siteConfig } from '@/config/site';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const homeEntry = await getEntry('site', 'home');

if (!homeEntry) {
  throw new Error('Missing home page content at src/content/site/home.json');
}

const home = homeEntry.data;
const pageTitle = home.seo.title.includes(siteConfig.name)
  ? home.seo.title
  : `${home.seo.title} — ${siteConfig.name}`;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const profileLinks = [
  { label: 'GitHub', href: siteConfig.github, external: true },
  { label: 'LinkedIn', href: siteConfig.linkedin, external: true },
  { label: 'Email', href: `mailto:${siteConfig.email}`, external: false },
].filter((link) => !isTodoValue(link.href.replace(/^mailto:/, '')));
const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={pageTitle} description={home.seo.description}>
  <section class="hero shell">
    <div>
      <p class="hero-kicker reveal">{home.hero.eyebrow}</p>
      <h1 class="reveal reveal-delay-1">{home.hero.title} <em>{home.hero.emphasis}</em><span class="caret" aria-hidden="true"></span></h1>
      <p class="hero-lede reveal reveal-delay-2">{home.hero.description}</p>
      <div class="hero-actions reveal reveal-delay-2">
        <a class="button button-primary" href="#selected-work">{home.hero.primaryLabel} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={withBase('blog/')}>{home.hero.secondaryLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="player-card reveal reveal-delay-2" aria-label={`About ${siteConfig.name}`}>
      <div class="player-card-bar">
        <span>Player profile</span>
        <span class="player-card-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="player-card-id">
        <img src={withBase(siteConfig.portrait)} alt={`Portrait of ${siteConfig.name}`} width="1254" height="1254" />
        <div>
          <p class="player-name">{siteConfig.name}</p>
          <p class="player-handle">{siteConfig.role}</p>
        </div>
      </div>
      <dl class="player-stats">
        {siteConfig.profile.map((item) => (
          <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
        ))}
      </dl>
      <ul class="player-links">
        {profileLinks.map((link) => (
          <li>
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section class="work-section" id="selected-work">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.work.eyebrow}</p>
          <h2>{home.work.title}</h2>
        </div>
        <p class="section-note">{home.work.noteLineOne}<br />{home.work.noteLineTwo}</p>
      </div>
      <div class="project-list">
        {projects.map((project, index) => (
          <ProjectCard
            number={String(index + 1).padStart(2, '0')}
            title={project.data.title}
            subtitle={project.data.subtitle}
            description={project.data.description}
            tags={project.data.tags}
            slug={project.slug}
            visualLabel={project.data.visualLabel}
            variant={project.data.visualVariant}
            image={project.data.cover}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="writing-section shell" id="devlog">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{home.writing.eyebrow}</p>
        <h2>{home.writing.title}</h2>
      </div>
      <a class="text-link" href={withBase('blog/')}>{home.writing.linkLabel} <span aria-hidden="true">→</span></a>
    </div>
    {publishedPosts.length > 0 ? (
      <div class="home-posts">
        {publishedPosts.map((post) => (
          <article class="home-post">
            <time datetime={post.data.publicationDate.toISOString()}>
              {post.data.publicationDate.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
            </time>
            <h3><a href={`${base}blog/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="terminal">
        <div class="terminal-bar">
          <span class="player-card-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>~/devlog</span>
        </div>
        <div class="terminal-body">
          <p><span class="terminal-prompt" aria-hidden="true">$ </span>{home.writing.emptyIndex}</p>
          <h3>{home.writing.emptyTitle}</h3>
          <p class="terminal-note">{home.writing.emptyText}</p>
          <p><span class="terminal-prompt" aria-hidden="true">$ </span><span class="caret" aria-hidden="true"></span></p>
        </div>
      </div>
    )}
  </section>

  <section class="about-section" id="about">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">{home.about.eyebrow}</p>
      </div>
      <div>
        <p class="about-statement">{home.about.leadBefore} <em>{home.about.leadEmphasis}</em> {home.about.leadAfter}</p>
        <p class="about-copy">{home.about.copy}</p>
        <ul class="research-list" aria-label="Interests">
          {home.about.researchAreas.map((area, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{area}</li>
          ))}
        </ul>
        <a class="text-link" href={withBase('contact/')}>{home.about.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow={home.cta.eyebrow}
    title={home.cta.title}
    text={home.cta.text}
    label={home.cta.label}
  />
</BaseLayout>
