---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '' },
  { label: 'Blog', href: 'blog/' },
  { label: 'Projects', href: 'projects/' },
  { label: 'Contact', href: 'contact/' },
];
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="site-identity" href={withBase('')} aria-label="Yin Yuan, home">
      <span>Yin Yuan</span>
      <span class="identity-mark" aria-hidden="true"></span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const href = withBase(item.href);
          const isActive = item.href === ''
            ? currentPath === base || currentPath === base.replace(/\/$/, '')
            : currentPath.startsWith(href);
          return (
            <li>
              <a href={href} aria-current={isActive ? 'page' : undefined}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
