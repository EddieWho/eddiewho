---
import Tags from './Tags.astro';

interface Props {
  number: string;
  title: string;
  subtitle?: string;
  description: string;
  tags: string[];
  slug: string;
  visualLabel: string;
  variant?: 'grid' | 'cards';
  image?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
}

const {
  number,
  title,
  subtitle,
  description,
  tags,
  slug,
  visualLabel,
  variant = 'grid',
  image,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${slug}/`;
---

<article class:list={['project-card', `project-card-${variant}`, { 'project-card-image': image }]}>
  <a href={href} aria-label={`View ${title}`}>
    <div class="project-visual">
      {image && (
        <img
          src={`${base}${image.src}`}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
        />
      )}
      <span class="project-number">{number}</span>
      {!image && <span class="visual-cross visual-cross-a" aria-hidden="true">+</span>}
      {!image && <span class="visual-cross visual-cross-b" aria-hidden="true">+</span>}
      <span class="visual-label">{visualLabel}</span>
    </div>
    <div class="project-content">
      <div class="project-title-row">
        <div>
          <h3>{title}</h3>
          {subtitle && <p class="project-subtitle">{subtitle}</p>}
        </div>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </div>
      <p class="project-description">{description}</p>
      <Tags tags={tags} dark />
    </div>
  </a>
</article>
