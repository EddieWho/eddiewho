---
import { getLocaleFromPath, localePath, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  label?: string;
  href?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const {
  eyebrow = t.cta.eyebrow,
  title = t.cta.title,
  text = t.cta.text,
  label = t.cta.label,
  href = 'contact/',
} = Astro.props;
---

<section class="cta-section">
  <div class="shell cta-grid">
    <p class="eyebrow">{eyebrow}</p>
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
      <a class="button button-light" href={localePath(href, locale)}>{label} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
