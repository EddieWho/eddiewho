---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  readingTime?: string;
  slug: string;
}

const { title, description, date, tags, readingTime, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="blog-card">
  <a href={`${base}blog/${slug}/`}>
    <div class="blog-card-meta">
      <time datetime={date.toISOString()}>{date.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
      {readingTime && <span>{readingTime}</span>}
    </div>
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="blog-card-tags">{tags.join(' · ')}</div>
  </a>
</article>
