---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  intro: string;
}

const { index, eyebrow, title, intro } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<header class="page-heading shell">
  <p class="eyebrow">{index} / {eyebrow}</p>
  <div class="page-heading-grid">
    <h1>{title}</h1>
    <div class:list={['page-heading-aside', { 'page-heading-aside-with-media': hasMedia }]}>
      {hasMedia && <slot name="media" />}
      <p>{intro}</p>
    </div>
  </div>
</header>
