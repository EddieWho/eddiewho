---
import CallToAction from '@/components/CallToAction.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isTodoValue, siteConfig, siteProfile } from '@/config/site';
import { formatDate, localeMeta, localePath, useTranslations, type Locale } from '@/i18n';
import { getHome, getPosts, getProjects } from '@/i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = siteProfile[locale];
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const home = await getHome(locale);
const pageTitle = home.seo.title.includes(siteConfig.name)
  ? home.seo.title
  : `${home.seo.title} — ${siteConfig.name}`;
const projects = await getProjects(locale);
const profileLinks = [
  { label: 'GitHub', href: siteConfig.github, external: true },
  { label: 'LinkedIn', href: siteConfig.linkedin, external: true },
  { label: t.contact.email, href: `mailto:${siteConfig.email}`, external: false },
].filter((link) => !isTodoValue(link.href.replace(/^mailto:/, '')));
const publishedPosts = (await getPosts()).slice(0, 3);
// Chinese runs words together, so no space around the highlighted phrase.
const gap = locale === 'zh' ? '' : ' ';
const postLang = (language: 'en' | 'zh') => (language !== locale ? localeMeta[language].htmlLang : undefined);
---

<BaseLayout title={pageTitle} description={home.seo.description}>
  <section class="hero shell">
    <div>
      <p class="hero-kicker reveal">{home.hero.eyebrow}</p>
      <h1 class="reveal reveal-delay-1">{home.hero.title}{gap}<em>{home.hero.emphasis}</em><span class="caret" aria-hidden="true"></span></h1>
      <p class="hero-lede reveal reveal-delay-2">{home.hero.description}</p>
      <div class="hero-actions reveal reveal-delay-2">
        <a class="button button-primary" href="#selected-work">{home.hero.primaryLabel} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={localePath('blog/', locale)}>{home.hero.secondaryLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="player-card reveal reveal-delay-2" aria-label={t.home.profileAria(siteConfig.name)}>
      <div class="player-card-bar">
        <span>{t.home.profileTitle}</span>
        <span class="player-card-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="player-card-id">
        <img src={withBase(siteConfig.portrait)} alt={t.portraitAlt(siteConfig.name)} width="1254" height="1254" />
        <div>
          <p class="player-name">{siteConfig.name}</p>
          <p class="player-handle">{profile.role}</p>
        </div>
      </div>
      <dl class="player-stats">
        {profile.profile.map((item) => (
          <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
        ))}
      </dl>
      <ul class="player-links">
        {profileLinks.map((link) => (
          <li>
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section class="work-section" id="selected-work">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.work.eyebrow}</p>
          <h2>{home.work.title}</h2>
        </div>
        <p class="section-note">{home.work.noteLineOne}<br />{home.work.noteLineTwo}</p>
      </div>
      <div class="project-list">
        {projects.map(({ slug, entry, translated }, index) => (
          <ProjectCard
            number={String(index + 1).padStart(2, '0')}
            title={entry.data.title}
            subtitle={entry.data.subtitle}
            description={entry.data.description}
            tags={entry.data.tags}
            slug={slug}
            visualLabel={entry.data.visualLabel}
            variant={entry.data.visualVariant}
            image={entry.data.cover}
            contentLang={translated ? undefined : 'en'}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="writing-section shell" id="devlog">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{home.writing.eyebrow}</p>
        <h2>{home.writing.title}</h2>
      </div>
      <a class="text-link" href={localePath('blog/', locale)}>{home.writing.linkLabel} <span aria-hidden="true">→</span></a>
    </div>
    {publishedPosts.length > 0 ? (
      <div class="home-posts">
        {publishedPosts.map((post) => (
          <article class="home-post">
            <time datetime={post.data.publicationDate.toISOString()}>{formatDate(post.data.publicationDate, locale)}</time>
            <h3 lang={postLang(post.data.language)}><a href={localePath(`blog/${post.slug}/`, locale)}>{post.data.title}</a></h3>
            <p lang={postLang(post.data.language)}>{post.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="terminal">
        <div class="terminal-bar">
          <span class="player-card-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>~/devlog</span>
        </div>
        <div class="terminal-body">
          <p><span class="terminal-prompt" aria-hidden="true">$ </span>{home.writing.emptyIndex}</p>
          <h3>{home.writing.emptyTitle}</h3>
          <p class="terminal-note">{home.writing.emptyText}</p>
          <p><span class="terminal-prompt" aria-hidden="true">$ </span><span class="caret" aria-hidden="true"></span></p>
        </div>
      </div>
    )}
  </section>

  <section class="about-section" id="about">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">{home.about.eyebrow}</p>
      </div>
      <div>
        <p class="about-statement">{home.about.leadBefore}{gap}<em>{home.about.leadEmphasis}</em>{gap}{home.about.leadAfter}</p>
        <p class="about-copy">{home.about.copy}</p>
        <ul class="research-list" aria-label={t.home.interestsLabel}>
          {home.about.researchAreas.map((area, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{area}</li>
          ))}
        </ul>
        <a class="text-link" href={localePath('contact/', locale)}>{home.about.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow={home.cta.eyebrow}
    title={home.cta.title}
    text={home.cta.text}
    label={home.cta.label}
  />
</BaseLayout>
